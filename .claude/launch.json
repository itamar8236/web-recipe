{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "dev"],
      "port": 8787,
      "autoPort": false
    },
    {
      "name": "frontend-agent",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "-p", "3001"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "backend-agent",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--prefix", "backend", "wrangler", "dev", "--cwd", "backend", "--port", "8788"],
      "port": 8788,
      "autoPort": true
    }
  ]
}
