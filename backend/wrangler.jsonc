{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-recipe",
  "compatibility_date": "2026-01-01",
  "main": "src/index.js",
  // The frontend's static build is served by Cloudflare directly; only /api/* runs the
  // Worker code.
  "assets": {
    "directory": "../frontend/out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Code reaches the database as env.DB. `wrangler deploy` binds the production
  // database; `wrangler dev` always uses a local copy in .wrangler/state. Never add
  // "remote": true here, or local dev would write to production.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recipes-db",
      "database_id": "960675bb-9caa-4787-816d-89783cd505b6"
    }
  ],
  // Keeps the Worker's logs (including every Gemini call and failure) for 3 days, free.
  "observability": { "enabled": true },
  // Runs an import in the background, so it keeps going after the user leaves the app.
  "workflows": [
    { "name": "recipe-import", "binding": "IMPORT_WORKFLOW", "class_name": "ImportWorkflow" }
  ],
  // Model names, their order and their limits are settings, so changing them needs no
  // code change. An import tries LLM_IMPORT_MODELS in order and a translation
  // LLM_TRANSLATE_MODELS, then the fallback model (Groq, text only, unused until
  // GROQ_API_KEY exists). LLM_BEST_MODEL is the one a user can ask for. LLM_DAILY_LIMITS
  // holds every model's requests a day; a model missing from it is never called.
  // GEMINI_API_KEY, YOUTUBE_API_KEY and GROQ_API_KEY are Worker secrets, never set here.
  "vars": {
    "LLM_IMPORT_MODELS": "gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite",
    "LLM_TRANSLATE_MODELS": "gemini-3.5-flash-lite",
    "LLM_BEST_MODEL": "gemini-4-hydrogen",
    "LLM_FALLBACK_MODEL": "openai/gpt-oss-120b",
    "LLM_DAILY_LIMITS": "gemini-3.8-flash:20,gemini-3.6-flash:20,gemini-3.5-flash-lite:500,gemini-4-hydrogen:20,openai/gpt-oss-120b:200",
    "IMPORT_MAX_VIDEO_MINUTES": 3,
    "IMPORT_MAX_VIDEO_MB": 100,
    "IMPORT_MAX_RUNNING": 3,
    "IMPORT_DAILY_LIMIT": 10,
    "IMPORT_BEST_DAILY_PER_USER": 5
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-main branches.
  // Previews don't inherit vars or Workflows, and a binding missing here can crash the
  // preview, so these repeat the values above.
  "previews": {
    "workflows": [
      { "name": "recipe-import", "binding": "IMPORT_WORKFLOW", "class_name": "ImportWorkflow" }
    ],
    "vars": {
      "LLM_IMPORT_MODELS": "gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite",
      "LLM_TRANSLATE_MODELS": "gemini-3.5-flash-lite",
      "LLM_BEST_MODEL": "gemini-4-hydrogen",
      "LLM_FALLBACK_MODEL": "openai/gpt-oss-120b",
      "LLM_DAILY_LIMITS": "gemini-3.8-flash:20,gemini-3.6-flash:20,gemini-3.5-flash-lite:500,gemini-4-hydrogen:20,openai/gpt-oss-120b:200",
      "IMPORT_MAX_VIDEO_MINUTES": 3,
      "IMPORT_MAX_VIDEO_MB": 100,
      "IMPORT_MAX_RUNNING": 3,
      "IMPORT_DAILY_LIMIT": 10,
      "IMPORT_BEST_DAILY_PER_USER": 5
    }
  }
}
